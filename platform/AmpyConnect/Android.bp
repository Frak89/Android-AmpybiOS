// Optional AmpyConnect app: unprivileged, user-initiated HTTPS read-only state viewer.
android_app {
    name: "AmpyConnect",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    product_specific: true,
}
