{
  "schema": 1,
  "scope": "AmpyCore window refresh preference and radar rendering only (NOT actual kernel CPU/GPU policy)",
  "device": "cheetah",
  "modes": [
    {
      "id": "eco",
      "max_preview_fps": 30,
      "max_radar_speed_dps": 45,
      "max_glow_percent": 15
    },
    {
      "id": "balanced",
      "max_preview_fps": 60,
      "max_radar_speed_dps": 180,
      "max_glow_percent": 40
    },
    {
      "id": "fusion-extreme",
      "max_preview_fps": 120,
      "max_radar_speed_dps": 360,
      "max_glow_percent": 65
    }
  ],
  "adaptive_safety": {
    "thermal_status_light_when_proactive": "limit to balanced",
    "thermal_status_moderate_when_proactive": "limit to eco",
    "thermal_status_moderate_when_disabled": "still limit to balanced",
    "thermal_status_severe_or_higher": "always limit to eco",
    "thermal_status_critical_or_higher": "always reduce motion",
    "android_battery_saver": "always limit to eco",
    "battery_percent_below_15_while_not_charging": "always limit to eco"
  },
  "security": {
    "root_required": false,
    "kernel_governor_changes": false,
    "adb_required": false,
    "background_monitoring": false,
    "selinux_modification": false
  },
  "defaults": {
    "profile": "fusion-extreme",
    "display_target_hz": 120,
    "standby_saver": true,
    "standby_idle_timeout_seconds": 30,
    "proactive_thermal_adaptation": true
  },
  "display": {
    "api": "WindowManager.LayoutParams.preferredRefreshRate",
    "request_is_advisory": true,
    "possible_choices_hz": [
      60,
      90,
      120
    ],
    "release_on_pause": true,
    "actual_refresh_from": "Display.getRefreshRate"
  },
  "standby_behavior": {
    "app_only": true,
    "animation_paused_in_background_always": true,
    "radar_paused_after_inactive_seconds": 30,
    "monitor_paused_while_idle": true,
    "system_power_saver_modified": false
  }
}
